{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.homingpigeon/homingpigeondev",
  "title": "Homing Pigeon",
  "description": "Homing Pigeon (homingpigeon.dev) sends text alerts from your code or agent to one phone: yours.",
  "websiteUrl": "https://homingpigeon.dev",
  "repository": {
    "url": "https://github.com/homingpigeondev/homingpigeondev",
    "source": "github"
  },
  "version": "0.1.4",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "homingpigeondev",
      "version": "0.1.2",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://homingpigeon.dev/mcp"
    }
  ],
  "icons": [
    {
      "src": "https://homingpigeon.dev/img/icon-400.png",
      "mimeType": "image/png",
      "sizes": [
        "400x400"
      ]
    }
  ]
}
